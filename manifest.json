{
  "manifest_version": 2,
  "name": "YouTube Transcript Yoinker",
  "version": "1.0.0",
  "description": "Yoink YouTube transcript to clipboard",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "*://*.youtube.com/*"
  ],
  "browser_action": {
    "default_icon": {
      "16": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    },
    "default_popup": "popup.html",
    "default_title": "Transcript Yoinker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
