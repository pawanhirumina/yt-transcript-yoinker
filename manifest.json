{
  "manifest_version": 2,
  "name": "YouTube Transcript Yoinker",
  "version": "1.0.3",
  "author": "Pawan Hirumina",
  "description": "Yoink YouTube transcripts to your clipboard.",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "*://*.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-transcript-yoinker@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/16.png",
      "32": "assets/32.png",
      "48": "assets/48.png",
      "128": "assets/128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Transcript Yoinker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
